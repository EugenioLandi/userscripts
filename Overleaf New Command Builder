                    grid-template-columns: 1fr;
                }
            }
        `;
        document.head.appendChild(style);
    }

    async function copyToClipboard(text) {
        if (navigator.clipboard?.writeText) {
            await navigator.clipboard.writeText(text);
            return;
        }

        const textarea = document.createElement('textarea');
        textarea.value = text;
        textarea.style.cssText = 'position:fixed;left:-9999px;';
        document.body.appendChild(textarea);
        textarea.select();
        document.execCommand('copy');
        textarea.remove();
    }


    const ARGUMENT_KIND_OPTIONS = [
        { value: 'm', label: 'm — mandatory' },
        { value: 'r', label: 'r — required delimited' },
        { value: 'R', label: 'R — required delimited with recovery default' },
        { value: 'v', label: 'v — verbatim' },
        { value: 'b', label: 'b — environment body' },
        { value: 'c', label: 'c — verbatim environment body' },
        { value: 'o', label: 'o — optional' },
        { value: 'd', label: 'd — optional delimited' },
        { value: 'O', label: 'O — optional with default' },
        { value: 'D', label: 'D — optional delimited with default' },
        { value: 's', label: 's — optional star' },
        { value: 't', label: 't — optional token' },
        { value: 'e', label: 'e — embellishments' },
        { value: 'E', label: 'E — embellishments with defaults' },
    ];

    function createArgument(kind = 'm') {
        return {
            kind,
            long: false,
            noSpace: false,
            keyvals: false,
            processor: '',
            open: '',
            close: '',
            defaultValue: '',
            token: '',
            tokens: '',
            defaults: '',
        };
    }

    function getDefaultData() {
        return {
            mode: 'command',
            name: '',
            comment: '',
            arguments: [createArgument('m')],
            body: '',
            endBody: '',
        };
    }

    function normalizeCount(value) {
        const parsed = Number.parseInt(String(value ?? ''), 10);
        return Number.isFinite(parsed) ? Math.max(0, parsed) : 0;
    }

    function normalizeText(value) {
        return String(value ?? '').trim();
    }

    function normalizeArgument(raw) {
        const fallbackKind = ARGUMENT_KIND_OPTIONS.some(option => option.value === raw?.kind) ? raw.kind : 'm';
        const argument = {
            ...createArgument(fallbackKind),
            ...(raw || {}),
        };

        argument.kind = ARGUMENT_KIND_OPTIONS.some(option => option.value === argument.kind) ? argument.kind : 'm';
        argument.long = Boolean(argument.long);
        argument.noSpace = Boolean(argument.noSpace);
        argument.keyvals = Boolean(argument.keyvals);
        argument.processor = String(argument.processor ?? '');
        argument.open = String(argument.open ?? '');
        argument.close = String(argument.close ?? '');
        argument.defaultValue = String(argument.defaultValue ?? '');
        argument.token = String(argument.token ?? '');
        argument.tokens = String(argument.tokens ?? '');
        argument.defaults = String(argument.defaults ?? '');
        return argument;
    }

    function hasLegacyBuilderData(raw) {
        return [
            'mandatoryCount',
            'optionalCount',
            'defaultOptionalCount',
            'delimitedCount',
            'defaultDelimitedCount',
            'hasStar',
            'tokenCount',
        ].some(key => Object.prototype.hasOwnProperty.call(raw || {}, key));
    }

    function migrateLegacyArguments(raw) {
        const argumentsList = [];

        for (let i = 0; i < normalizeCount(raw.mandatoryCount); i += 1) {
            argumentsList.push(createArgument('m'));
        }

        for (let i = 0; i < normalizeCount(raw.optionalCount); i += 1) {
            argumentsList.push(createArgument('o'));
        }

        for (let i = 0; i < normalizeCount(raw.defaultOptionalCount); i += 1) {
            argumentsList.push(normalizeArgument({
                kind: 'O',
                defaultValue: String(raw.optionalDefaults?.[i] ?? ''),
            }));
        }

        for (let i = 0; i < normalizeCount(raw.delimitedCount); i += 1) {
            argumentsList.push(normalizeArgument({
                kind: 'd',
                open: raw.delimitedPairs?.[i]?.open ?? '',
                close: raw.delimitedPairs?.[i]?.close ?? '',
            }));
        }

        for (let i = 0; i < normalizeCount(raw.defaultDelimitedCount); i += 1) {
            argumentsList.push(normalizeArgument({
                kind: 'D',
                open: raw.defaultDelimitedPairs?.[i]?.open ?? '',
                close: raw.defaultDelimitedPairs?.[i]?.close ?? '',
                defaultValue: raw.defaultDelimitedPairs?.[i]?.defaultValue ?? '',
            }));
        }

        if (raw.hasStar) {
            argumentsList.push(createArgument('s'));
        }

        for (let i = 0; i < normalizeCount(raw.tokenCount); i += 1) {
            argumentsList.push(normalizeArgument({
                kind: 't',
                token: raw.tokenValues?.[i] ?? '',
            }));
        }

        return argumentsList.length ? argumentsList : getDefaultData().arguments.map(argument => normalizeArgument(argument));
    }

    function normalizeData(raw) {
        const defaults = getDefaultData();
        const source = raw || {};
        const data = {
            ...defaults,
            ...source,
        };

        data.mode = source.mode === 'environment' ? 'environment' : 'command';
        data.name = String(source.name ?? source.commandName ?? defaults.name ?? '');
        data.comment = String(source.comment ?? '');
        data.body = String(source.body ?? '');
        data.endBody = String(source.endBody ?? '');

        if (Array.isArray(source.arguments)) {
            data.arguments = source.arguments.map(argument => normalizeArgument(argument));
        } else if (hasLegacyBuilderData(source)) {
            data.arguments = migrateLegacyArguments(source);
        } else {
            data.arguments = defaults.arguments.map(argument => normalizeArgument(argument));
        }

        return data;
    }

    function getBuilderData() {
        return normalizeData(storage.get(storage.keys.data(), getDefaultData()));
    }

    function saveBuilderData(nextData) {
        const normalized = normalizeData(nextData);
        storage.set(storage.keys.data(), normalized);
        return normalized;
    }

    function normalizeCommandName(value) {
        let name = String(value || '').trim();
        if (!name) return '';
        if (name.startsWith('{') && name.endsWith('}')) {
            name = name.slice(1, -1).trim();
        }
        name = name.replace(/^\\+/, '');
        if (!name) return '';
        return `\\${name}`;
    }

    function isValidCommandName(name) {
        return /^\\(?:[A-Za-z@]+|[^\s{}])$/.test(name);
    }

    function normalizeEnvironmentName(value) {
        let name = String(value || '').trim();
        if (!name) return '';
        if (name.startsWith('{') && name.endsWith('}')) {
            name = name.slice(1, -1).trim();
        }
        return name.replace(/^\\+/, '').trim();
    }

    function isValidEnvironmentName(name) {
        return /^[^\s{}\\]+$/.test(name);
    }

    function tokenizeArgumentList(value) {
        const text = String(value ?? '').trim();
        const tokens = [];

        for (let index = 0; index < text.length;) {
            const char = text[index];
            if (/\s/.test(char)) {
                index += 1;
                continue;
            }

            if (char === '\\') {
                let cursor = index + 1;
                if (/[A-Za-z@]/.test(text[cursor] || '')) {
                    while (/[A-Za-z@]/.test(text[cursor] || '')) cursor += 1;
                } else if (cursor < text.length) {
                    cursor += 1;
                }
                tokens.push(text.slice(index, cursor));
                index = cursor;
                continue;
            }

            tokens.push(char);
            index += 1;
        }

        return tokens;
    }

    function isOptionalKind(kind) {
        return ['o', 'd', 'O', 'D', 's', 't', 'e', 'E'].includes(kind);
    }

    function isEnvironmentOnlyKind(kind) {
        return kind === 'b' || kind === 'c';
    }

    function getArgumentFieldCount(argument) {
        if (argument.kind === 'e' || argument.kind === 'E') {
            return tokenizeArgumentList(argument.tokens).length;
        }
        return 1;
    }

    function buildArgumentSpec(argument) {
        let base = argument.kind;

        if (argument.kind === 'r' || argument.kind === 'd') {
            base = `${argument.kind}${argument.open}${argument.close}`;
        } else if (argument.kind === 'R' || argument.kind === 'D') {
            base = `${argument.kind}${argument.open}${argument.close}{${argument.defaultValue}}`;
        } else if (argument.kind === 'O') {
            base = `O{${argument.defaultValue}}`;
        } else if (argument.kind === 't') {
            base = `t${argument.token}`;
        } else if (argument.kind === 'e') {
            base = `e{${argument.tokens}}`;
        } else if (argument.kind === 'E') {
            base = `E{${argument.tokens}}{${argument.defaults}}`;
        }

        let modifiers = '';
        if (argument.long) modifiers += '+';
        if (argument.noSpace) modifiers += '!';
        if (argument.keyvals) modifiers += '=';
        if (normalizeText(argument.processor)) modifiers += `>{${normalizeText(argument.processor)}}`;
        return `${modifiers}${base}`;
    }

    function createDefinition(index, argument, label, hint) {
        return {
            index,
            kind: argument.kind,
            spec: buildArgumentSpec(argument),
            label,
            hint,
        };
    }

    function buildDefinitions(data) {
        const definitions = [];
        let index = 1;

        data.arguments.forEach((argument, argumentIndex) => {
            const entryNumber = argumentIndex + 1;
            const reference = `#${index}`;
            const defaultText = argument.defaultValue || '(empty default)';

            switch (argument.kind) {
            case 'm':
                definitions.push(createDefinition(index, argument, `Mandatory argument ${entryNumber}`, `Use ${reference}.`));
                index += 1;
                break;
            case 'r':
                definitions.push(createDefinition(index, argument, `Required delimited argument ${entryNumber}`, `Use ${reference}; a missing opening delimiter recovers with -NoValue-.`));
                index += 1;
                break;
            case 'R':
                definitions.push(createDefinition(index, argument, `Required delimited argument ${entryNumber} with default`, `Use ${reference}; a missing opening delimiter recovers with ${defaultText}.`));
                index += 1;
                break;
            case 'v':
                definitions.push(createDefinition(index, argument, `Verbatim argument ${entryNumber}`, `Use ${reference}; verbatim arguments cannot appear inside another argument.`));
                index += 1;
                break;
            case 'b':
                definitions.push(createDefinition(index, argument, 'Environment body', `Use ${reference} in the begin or end code.`));
                index += 1;
                break;
            case 'c':
                definitions.push(createDefinition(index, argument, 'Verbatim environment body', `Use ${reference} when you need the environment body collected verbatim.`));
                index += 1;
                break;
            case 'o':
                definitions.push(createDefinition(index, argument, `Optional argument ${entryNumber}`, `Usually inside \\IfValueT{${reference}}{...}.`));
                index += 1;
                break;
            case 'd':
                definitions.push(createDefinition(index, argument, `Delimited optional argument ${entryNumber}`, `Usually inside \\IfValueT{${reference}}{...}.`));
                index += 1;
                break;
            case 'O':
                definitions.push(createDefinition(index, argument, `Optional argument ${entryNumber} with default`, `Use ${reference}; when omitted, it defaults to ${defaultText}.`));
                index += 1;
                break;
            case 'D':
                definitions.push(createDefinition(index, argument, `Delimited optional argument ${entryNumber} with default`, `Use ${reference}; when omitted, it defaults to ${defaultText}.`));
                index += 1;
                break;
            case 's':
                definitions.push(createDefinition(index, argument, 'Star boolean', `Usually inside \\IfBooleanTF{${reference}}{...}{...}.`));
                index += 1;
                break;
            case 't':
                definitions.push(createDefinition(index, argument, `Token boolean ${entryNumber}`, `Usually inside \\IfBooleanTF{${reference}}{...}{...}.`));
                index += 1;
                break;
            case 'e': {
                const tokens = tokenizeArgumentList(argument.tokens);
                tokens.forEach((token, tokenIndex) => {
                    const currentReference = `#${index}`;
                    definitions.push(createDefinition(
                        index,
                        argument,
                        `Embellishment ${entryNumber}.${tokenIndex + 1} (${token})`,
                        `Usually inside \\IfValueT{${currentReference}}{...}.`,
                    ));
                    index += 1;
                });
                break;
            }
            case 'E': {
                const tokens = tokenizeArgumentList(argument.tokens);
                tokens.forEach((token, tokenIndex) => {
                    const currentReference = `#${index}`;
                    definitions.push(createDefinition(
                        index,
                        argument,
                        `Embellishment ${entryNumber}.${tokenIndex + 1} (${token}) with default`,
                        `Use ${currentReference}; omitted ${token} values fall back to the E defaults.`,
                    ));
                    index += 1;
                });
                break;
            }
            default:
                break;
            }
        });

        return definitions;
    }

    function getStarterLine(definition) {
        const ref = `#${definition.index}`;

        if (definition.kind === 'o' || definition.kind === 'd' || definition.kind === 'e') {
            return `\\IfValueT{${ref}}{${ref}}`;
        }

        if (definition.kind === 's') {
            return [
                `\\IfBooleanTF{${ref}}{`,
                '    % starred form',
                '}{',
                '    % unstarred form',
                '}',
            ].join('\n');
        }

        if (definition.kind === 't') {
            return [
                `\\IfBooleanTF{${ref}}{`,
                '    % token present',
                '}{',
                '    % token absent',
                '}',
            ].join('\n');
        }

        return ref;
    }

    function generateStarterBody(data) {
        const definitions = buildDefinitions(data);
        if (definitions.length === 0) {
            return data.mode === 'environment'
                ? '% Add your environment code here'
                : '% Add your macro body here';
        }
        return definitions.map(getStarterLine).join('\n');
    }

    function indentBlock(text, spaces = 4) {
        const indent = ' '.repeat(spaces);
        return String(text || '')
            .replace(/\r\n/g, '\n')
            .split('\n')
            .map(line => line ? `${indent}${line}` : '')
            .join('\n');
    }

    function stripLatexComments(text) {
        return String(text || '')
            .replace(/\r\n/g, '\n')
            .split('\n')
            .map(line => {
                for (let index = 0; index < line.length; index += 1) {
                    if (line[index] !== '%') continue;
                    let backslashCount = 0;
                    for (let cursor = index - 1; cursor >= 0 && line[cursor] === '\\'; cursor -= 1) {
                        backslashCount += 1;
                    }
                    if (backslashCount % 2 === 0) {
                        return line.slice(0, index);
                    }
                }
                return line;
            })
            .join('\n');
    }

    function bodyUsesField(body, index) {
        return stripLatexComments(body).includes(`#${index}`);
    }

    function buildSnippet(data) {
        const normalized = normalizeData(data);
        const definitions = buildDefinitions(normalized);
        const signature = normalized.arguments.map(argument => buildArgumentSpec(argument)).join(' ');
        const errors = [];
        const beginBody = normalized.body.trim();
        const endBody = normalized.endBody.trim();
        const combinedBody = normalized.mode === 'environment'
            ? [beginBody, endBody].filter(Boolean).join('\n')
            : beginBody;
        const displayName = normalized.mode === 'environment'
            ? normalizeEnvironmentName(normalized.name)
            : normalizeCommandName(normalized.name);

        if (!displayName) {
            errors.push(normalized.mode === 'environment' ? 'Enter the environment name.' : 'Enter the command name.');
        } else if (normalized.mode === 'environment') {
            if (!isValidEnvironmentName(displayName)) {
                errors.push('Use an environment name without spaces, braces, or a leading backslash.');
            }
        } else if (!isValidCommandName(displayName)) {
            errors.push('Use a single LaTeX command name like \\mycommand or mycommand.');
        }

        const totalArguments = definitions.length;
        if (totalArguments > 9) {
            errors.push('LaTeX command and environment definitions can only use up to 9 parameters (#1 to #9).');
        }

        if (!combinedBody) {
            errors.push(normalized.mode === 'environment'
                ? 'Write the begin code, the end code, or use “Fill starter body”.'
                : 'Write the command body or use “Fill starter body”.');
        }

        normalized.arguments.forEach((argument, index) => {
            const number = index + 1;
            const kindLabel = argument.kind;
            const tokens = tokenizeArgumentList(argument.tokens);

            if ((argument.kind === 'r' || argument.kind === 'R' || argument.kind === 'd' || argument.kind === 'D') && (!normalizeText(argument.open) || !normalizeText(argument.close))) {
                errors.push(`Fill both delimiters for ${kindLabel} argument ${number}.`);
            }

            if ((argument.kind === 'O' || argument.kind === 'R' || argument.kind === 'D') && argument.defaultValue === '') {
                errors.push(`Fill the default value for ${kindLabel} argument ${number}.`);
            }

            if (argument.kind === 't' && !normalizeText(argument.token)) {
                errors.push(`Fill the token for t argument ${number}.`);
            }

            if ((argument.kind === 'e' || argument.kind === 'E') && !tokens.length) {
                errors.push(`Fill the token list for ${kindLabel} argument ${number}.`);
            }

            if ((argument.kind === 'e' || argument.kind === 'E') && new Set(tokens).size !== tokens.length) {
                errors.push(`Use distinct embellishment tokens for ${kindLabel} argument ${number}.`);
            }

            if (argument.kind === 'E' && argument.defaults === '') {
                errors.push(`Fill the defaults list for E argument ${number}.`);
            }

            if (isEnvironmentOnlyKind(argument.kind) && normalized.mode !== 'environment') {
                errors.push(`${kindLabel} is only valid for environments. Switch the builder to environment mode.`);
            }
        });

        const environmentBodyArguments = normalized.arguments.filter(argument => isEnvironmentOnlyKind(argument.kind));
        if (environmentBodyArguments.length > 1) {
            errors.push('Use at most one environment body argument (b or c).');
        }

        const missingArguments = combinedBody
            ? definitions.filter(definition => !bodyUsesField(combinedBody, definition.index))
            : [];

        if (missingArguments.length) {
            errors.push(`Use every generated field in the body: ${missingArguments.map(definition => `#${definition.index}`).join(', ')}.`);
        }

        const snippetLines = [];
        const comment = normalized.comment.trim();

        if (comment) {
            snippetLines.push(`% ${comment}`);
        }

        if (!errors.length) {
            if (normalized.mode === 'environment') {
                snippetLines.push(`\\NewDocumentEnvironment{${displayName}}{${signature}}{%`);
                snippetLines.push(indentBlock(beginBody));
                snippetLines.push('}{%');
                snippetLines.push(indentBlock(endBody));
                snippetLines.push('}');
            } else {
                snippetLines.push(`\\NewDocumentCommand{${displayName}}{${signature}}{%`);
                snippetLines.push(indentBlock(beginBody));
                snippetLines.push('}');
            }
        }

        return {
            ok: errors.length === 0,
            errors,
            snippet: snippetLines.join('\n'),
            signature,
            definitions,
            totalArguments,
            displayName,
            mode: normalized.mode,
        };
    }

