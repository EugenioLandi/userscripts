                color: var(--oncb-muted);
            }
            .oncb-input,
            .oncb-textarea,
            .oncb-preview {
                width: 100%;
                padding: 8px 10px;
                border: 1px solid var(--oncb-border);
                border-radius: 6px;
                background: var(--oncb-inputBg);
                color: inherit;
                font-size: 13px;
                box-sizing: border-box;
            }
            .oncb-textarea,
            .oncb-preview {
                min-height: 180px;
                font-family: ui-monospace, monospace;
                font-size: 12px;
                line-height: 1.55;
                resize: vertical;
            }
            .oncb-preview {
                min-height: 220px;
            }
            .oncb-number-row,
            .oncb-inline-row {
                display: flex;
                gap: 8px;
                align-items: center;
                flex-wrap: wrap;
            }
            .oncb-inline-row .oncb-input {
                flex: 1;
                min-width: 0;
            }
            .oncb-checkbox {
                display: flex;
                align-items: center;
                gap: 8px;
                font-size: 13px;
            }
            .oncb-actions {
                display: flex;
                gap: 8px;
                flex-wrap: wrap;
            }
            .oncb-button {
                padding: 6px 10px;
                border: 1px solid var(--oncb-border);
                border-radius: 6px;
                background: var(--oncb-buttonBg);
                color: inherit;
                cursor: pointer;
                font-size: 12px;
                font-weight: 600;
            }
            .oncb-button:hover {
                background: var(--oncb-hover);
            }
            .oncb-status {
                padding: 10px 12px;
                border: 1px solid var(--oncb-border);
