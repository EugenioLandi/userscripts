            }
            .oncb-status.ok {
                border-color: rgba(74, 222, 128, 0.5);
            }
            .oncb-status.error {
                border-color: rgba(248, 113, 113, 0.45);
            }
            .oncb-status strong {
                color: var(--oncb-ok);
            }
            .oncb-status.error strong {
                color: var(--oncb-error);
            }
            .oncb-list {
                margin: 0;
                padding-left: 18px;
                display: flex;
                flex-direction: column;
                gap: 4px;
