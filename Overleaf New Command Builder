            if (nextData.mode === 'environment' && !nextData.endBody.trim()) {
                nextData.endBody = '% Add your environment closing code here';
            }
            saveBuilderData(nextData);
            renderBuilder(widget);
            setFooter(`Starter body generated for ${utils.getProjectName()}`);
        });

        copyButton.addEventListener('click', async () => {
            const currentData = getBuilderData();
            const result = updateDerivedSections(widget, currentData, nodes);
            if (!result.ok || !result.snippet) {
                setFooter('Fix the highlighted issues before copying');
                return;
            }

            await copyToClipboard(result.snippet);
            setFooter(`${result.mode === 'environment' ? 'Environment' : 'Command'} copied to clipboard`);
        });

        clearButton.addEventListener('click', () => {
            const scopeLabel = utils.getProjectId() ? 'this Overleaf project' : 'this Overleaf page';
            if (!window.confirm(`Clear the saved builder data for ${scopeLabel}?`)) return;
            storage.remove(storage.keys.data());
            renderBuilder(widget);
            setFooter(`Builder reset for ${utils.getProjectName()}`);
        });

        body.append(
            intro,
            grid,
            argumentField.wrapper,
            status,
            signatureCard,
            guideCard,
            bodyField.wrapper,
            ...(data.mode === 'environment' ? [endBodyField.wrapper] : []),
            actions,
            previewField.wrapper,
        );

        updateDerivedSections(widget, data, nodes);
        setFooter(`Stored locally for ${utils.getProjectName()}`);
    }

    function buttonsFindContainer() {
        const wrapper = document.querySelector(CONFIG.selectors.tabsWrapper);
        const fileTreeTab = wrapper?.querySelector(CONFIG.selectors.fileTreeTab);
        const template = fileTreeTab || wrapper?.querySelector('button, [role="tab"]');
        return { wrapper, template };
    }

    function buttonsCreate(template) {
        const button = document.createElement('button');
        const classList = template
            ? [...template.classList].filter(item => !['d-flex', 'flex-column', 'align-items-center', 'justify-content-center', 'text-center', 'p-0', 'px-0', 'py-0'].includes(item))
            : ['nav-link'];

        button.className = classList.join(' ');
        button.type = 'button';
        button.setAttribute(CONFIG.buttonAttr, PANEL.id);
        button.dataset.panelId = PANEL.id;
        button.setAttribute('aria-label', PANEL.title);
        button.setAttribute('title', PANEL.title);

        const iconWrapper = document.createElement('span');
        iconWrapper.className = 'icon-wrapper';
        iconWrapper.innerHTML = PANEL.icon;
        button.appendChild(iconWrapper);

        button.addEventListener('click', (event) => {
            event.preventDefault();
            event.stopPropagation();
            widgetsToggle();
        }, true);

        state.button = button;
        return button;
    }

    function buttonsUpdateState() {
        if (!state.button) return;
        const isOpen = Boolean(state.widget?.classList.contains('open'));
        state.button.classList.toggle('active', isOpen);
        state.button.setAttribute('aria-pressed', isOpen ? 'true' : 'false');
    }

    function buttonsSync() {
        const { wrapper, template } = buttonsFindContainer();
        if (!wrapper || !template) return;

        document.documentElement.style.setProperty('--oncb-activeBg', theme.get().activeBg);

        let button = wrapper.querySelector(`[${CONFIG.buttonAttr}="${PANEL.id}"]`);
        if (!button) {
            button = buttonsCreate(template);
            wrapper.appendChild(button);
        } else {
            state.button = button;
        }

        buttonsUpdateState();
    }

    function syncAll() {
        buttonsSync();
    }

    function scheduledSync(delay = 0) {
        clearTimeout(state.timers.sync);
        state.timers.sync = setTimeout(syncAll, delay);
    }

    function watchDom() {
        if (state.observer) return;

        state.observer = new MutationObserver(() => {
            if (state.lastHref !== window.location.href) {
                state.lastHref = window.location.href;
                if (state.widget?.classList.contains('open')) {
                    renderBuilder(state.widget);
                }
            }
            scheduledSync(CONFIG.debounceMs);
        });

        state.observer.observe(document.documentElement, { childList: true, subtree: true });

        window.addEventListener('popstate', () => scheduledSync(0));
        window.addEventListener('hashchange', () => scheduledSync(0));
        window.addEventListener('focus', () => scheduledSync(0));
        window.addEventListener('mouseup', widgetsSaveGeometry, true);
        window.addEventListener('pointerup', widgetsSaveGeometry, true);
        window.addEventListener('resize', utils.debounce(() => {
            if (state.widget?.classList.contains('open')) {
                widgetsRestoreGeometry(state.widget);
            }
        }, CONFIG.debounceMs));
    }

    function init() {
        if (!document.body) {
            setTimeout(init, 100);
            return;
        }

        injectStyles();
        watchDom();
        scheduledSync(0);
    }

    init();
})();
