            const processorField = createField({ label: 'Argument processor', help: 'Leave blank to skip the > processor prefix.' , full: true });
            const processorInput = createTextInput(argument.processor, '\\TrimSpaces');
            processorField.wrapper.appendChild(processorInput);
            cardGrid.appendChild(processorField.wrapper);

            const addSpecificField = ({ label, help, value, placeholder, property }) => {
