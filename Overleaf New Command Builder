// @namespace    http://tampermonkey.net/
// @version      1.1.0
// @description  Build xparse command and environment snippets inside Overleaf with live validation and clipboard copy
// @match        https://*.overleaf.com/project/*
// @updateURL    https://raw.githubusercontent.com/EugenioLandi/userscripts/main/Overleaf%20New%20Command%20Builder
// @downloadURL  https://raw.githubusercontent.com/EugenioLandi/userscripts/main/Overleaf%20New%20Command%20Builder
// @grant        none
// @run-at       document-idle
// ==/UserScript==

(function () {
    'use strict';

    if (window.__overleafNewCommandBuilderInitialized) return;
    window.__overleafNewCommandBuilderInitialized = true;

    const CONFIG = {
        styleId: 'overleaf-new-command-builder-style',
        buttonAttr: 'data-oncb-button',
        widgetAttr: 'data-oncb-widget',
        debounceMs: 150,
        zIndexBase: 100000,
        widget: {
            padding: 16,
            minTop: 72,
            minWidth: 420,
            minHeight: 360,
            defaultWidth: 560,
            defaultHeight: 720,
        },
        selectors: {
            tabsWrapper: '.ide-rail-tabs-wrapper',
            fileTreeTab: '[data-rr-ui-event-key="file-tree"]',
            dragIgnore: 'button, input, textarea, select, label',
        },
        storageKey: 'overleaf-new-command-builder',
    };

    const PANEL = {
        id: 'new-command-builder',
        title: 'New command builder',
        subtitle: 'Build and copy xparse command and environment snippets',
        icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M8 6h12"/><path d="M8 12h12"/><path d="M8 18h12"/><path d="M3 6h.01"/><path d="M3 12h.01"/><path d="M3 18h.01"/></svg>',
        defaultX: 280,
        defaultY: 112,
        defaultWidth: 560,
        defaultHeight: 720,
    };

    const state = {
        widget: null,
        button: null,
        zIndex: CONFIG.zIndexBase,
        observer: null,
        timers: { sync: null },
        lastHref: window.location.href,
    };

    const utils = {
        getProjectId() {
            const match = window.location.pathname.match(/\/project\/([^/]+)/);
            return match ? match[1] : null;
        },

        getProjectName() {
            const selectors = [
                '.ide-redesign-toolbar-project-name',
                '[data-testid="project-name"]',
                'input[aria-label="Project name"]',
            ];
            for (const sel of selectors) {
                const el = document.querySelector(sel);
                const value = el?.value || el?.textContent;
                if (value?.trim()) return value.trim();
            }
            return document.title.replace(/\s*-\s*Overleaf.*$/i, '').trim() || 'Untitled';
        },

        getStorageScope() {
            return utils.getProjectId() || `page:${window.location.pathname}`;
        },

        clamp(value, min, max) {
            return Math.max(min, Math.min(max, value));
        },

        debounce(fn, ms) {
            let timer = null;
            return (...args) => {
                clearTimeout(timer);
                timer = setTimeout(() => fn(...args), ms);
            };
        },

        slug(value) {
            return String(value || '')
                .trim()
                .replace(/\s+/g, '-')
                .replace(/[^a-z0-9-]/gi, '')
                .toLowerCase();
        },
    };

    const storage = {
        get(key, fallback = null) {
            try {
                const raw = localStorage.getItem(key);
                return raw ? JSON.parse(raw) : fallback;
            } catch {
                return fallback;
            }
        },

        set(key, value) {
            try {
                localStorage.setItem(key, JSON.stringify(value));
            } catch {
                // Ignore quota errors
            }
        },

        remove(key) {
            try {
                localStorage.removeItem(key);
            } catch {
                // Ignore
            }
        },

        keys: {
            data: () => `${CONFIG.storageKey}:${utils.getStorageScope()}:data`,
            position: () => `${CONFIG.storageKey}:position`,
            size: () => `${CONFIG.storageKey}:size`,
        },
    };

    const theme = {
        get() {
            return {
                bg: '#1b222c',
                fg: '#dbe5f3',
                border: '#46566f',
                muted: '#aab6c8',
                buttonBg: '#273142',
                hover: '#354258',
                inputBg: '#2f3a4c',
                cardBg: '#2f3a4c',
                activeBg: '#2f3a4c',
                ok: '#4ade80',
                error: '#f87171',
            };
        },

        apply(element) {
            Object.entries(theme.get()).forEach(([key, value]) => {
                element.style.setProperty(`--oncb-${key}`, value);
            });
        },
    };

    function injectStyles() {
        if (document.getElementById(CONFIG.styleId)) return;

        const style = document.createElement('style');
        style.id = CONFIG.styleId;
        style.textContent = `
            [${CONFIG.buttonAttr}] {
                position: relative;
                display: inline-flex !important;
                align-items: center !important;
                justify-content: center !important;
                margin-inline: auto;
                padding: 0 !important;
            }
            [${CONFIG.buttonAttr}] .icon-wrapper {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                width: 20px;
                height: 20px;
                pointer-events: none;
            }
            [${CONFIG.buttonAttr}] svg {
                width: 20px;
                height: 20px;
            }
            [${CONFIG.buttonAttr}].active {
                background: var(--oncb-activeBg, #2f3a4c) !important;
            }
            [${CONFIG.widgetAttr}] {
                position: fixed;
                z-index: ${CONFIG.zIndexBase};
                display: none;
                flex-direction: column;
                width: ${CONFIG.widget.defaultWidth}px;
                height: ${CONFIG.widget.defaultHeight}px;
                min-width: ${CONFIG.widget.minWidth}px;
                min-height: ${CONFIG.widget.minHeight}px;
                overflow: hidden;
                resize: both;
                border: 1px solid var(--oncb-border);
                border-radius: 14px;
                background: var(--oncb-bg);
                color: var(--oncb-fg);
                box-shadow: 0 22px 48px rgba(15, 23, 42, 0.22);
            }
            [${CONFIG.widgetAttr}].open {
                display: flex;
            }
            .oncb-header {
                display: flex;
                gap: 10px;
                padding: 14px 16px;
                border-bottom: 1px solid var(--oncb-border);
                cursor: grab;
                user-select: none;
            }
            .oncb-header.dragging {
                cursor: grabbing;
            }
            .oncb-heading {
                flex: 1;
                min-width: 0;
            }
            .oncb-title {
                margin: 0;
                font-size: 15px;
                font-weight: 700;
                line-height: 1.35;
            }
            .oncb-subtitle {
                margin: 3px 0 0;
