    function widgetsGet() {
        return state.widget?.isConnected ? state.widget : widgetsCreate();
    }

    function widgetsOpen() {
        const widget = widgetsGet();
        renderBuilder(widget);
        widget.classList.add('open');
        widgetsBringToFront(widget);
        buttonsUpdateState();
    }

    function widgetsClose() {
        if (!state.widget) return;
        state.widget.classList.remove('open');
        buttonsUpdateState();
    }

    function widgetsToggle() {
        if (state.widget?.classList.contains('open')) {
            widgetsClose();
        } else {
            widgetsOpen();
        }
    }

    function widgetsBringToFront(widget) {
        state.zIndex += 1;
        widget.style.zIndex = state.zIndex;
    }

    function widgetsSaveGeometry() {
        if (!state.widget) return;
        const rect = state.widget.getBoundingClientRect();
        storage.set(storage.keys.position(), { x: rect.left, y: rect.top });
        storage.set(storage.keys.size(), { width: rect.width, height: rect.height });
    }

    function widgetsRestoreGeometry(widget) {
        const savedPosition = storage.get(storage.keys.position(), { x: PANEL.defaultX, y: PANEL.defaultY });
        const savedSize = storage.get(storage.keys.size(), { width: PANEL.defaultWidth, height: PANEL.defaultHeight });

        const x = utils.clamp(savedPosition.x, CONFIG.widget.padding, window.innerWidth - CONFIG.widget.minWidth - CONFIG.widget.padding);
        const y = utils.clamp(savedPosition.y, CONFIG.widget.minTop, window.innerHeight - CONFIG.widget.minHeight - CONFIG.widget.padding);
        const width = utils.clamp(savedSize.width, CONFIG.widget.minWidth, window.innerWidth - CONFIG.widget.padding * 2);
        const height = utils.clamp(savedSize.height, CONFIG.widget.minHeight, window.innerHeight - CONFIG.widget.minTop - CONFIG.widget.padding);

        widget.style.left = `${x}px`;
        widget.style.top = `${y}px`;
        widget.style.width = `${width}px`;
        widget.style.height = `${height}px`;
    }

    function widgetsMakeDraggable(widget, handle) {
        let pointerId = null;
        let startX = 0;
        let startY = 0;
        let originX = 0;
        let originY = 0;

        handle.addEventListener('pointerdown', (event) => {
            if (event.button !== 0) return;
            if (event.target.closest(CONFIG.selectors.dragIgnore)) return;

            pointerId = event.pointerId;
            if (typeof handle.setPointerCapture === 'function') {
                try {
                    handle.setPointerCapture(pointerId);
                } catch {
                    // Ignore lost-pointer races
                }
            }

            const rect = widget.getBoundingClientRect();
            originX = rect.left;
            originY = rect.top;
            startX = event.clientX;
            startY = event.clientY;

            handle.classList.add('dragging');
            widgetsBringToFront(widget);
            event.preventDefault();
        });

        handle.addEventListener('pointermove', (event) => {
            if (event.pointerId !== pointerId) return;

            const dx = event.clientX - startX;
            const dy = event.clientY - startY;
            const x = utils.clamp(originX + dx, CONFIG.widget.padding, window.innerWidth - widget.offsetWidth - CONFIG.widget.padding);
            const y = utils.clamp(originY + dy, CONFIG.widget.minTop, window.innerHeight - widget.offsetHeight - CONFIG.widget.padding);

            widget.style.left = `${x}px`;
            widget.style.top = `${y}px`;
        });

        const release = (event) => {
            if (event.pointerId !== pointerId) return;
            pointerId = null;
            handle.classList.remove('dragging');
            widgetsSaveGeometry();
        };

        handle.addEventListener('pointerup', release);
        handle.addEventListener('pointercancel', release);
    }

    function createField({ label, help, full = false }) {
        const wrapper = document.createElement('div');
        wrapper.className = `oncb-field${full ? ' full' : ''}`;

        const labelElement = document.createElement('label');
        labelElement.className = 'oncb-label';
        labelElement.textContent = label;
        wrapper.appendChild(labelElement);

        if (help) {
            const helpElement = document.createElement('div');
            helpElement.className = 'oncb-help';
            helpElement.textContent = help;
            wrapper.appendChild(helpElement);
        }

        return { wrapper, labelElement };
    }

    function createNumberInput(value) {
        const input = document.createElement('input');
        input.className = 'oncb-input';
        input.type = 'number';
        input.min = '0';
        input.max = '9';
        input.value = String(value);
        return input;
    }

    function createTextInput(value, placeholder = '') {
        const input = document.createElement('input');
        input.className = 'oncb-input';
        input.type = 'text';
        input.placeholder = placeholder;
        input.value = value;
        return input;
    }

    function createSelect(options, value) {
        const select = document.createElement('select');
        select.className = 'oncb-input';
        options.forEach(option => {
            const node = document.createElement('option');
            node.value = option.value;
            node.textContent = option.label;
            select.appendChild(node);
        });
        select.value = value;
        return select;
    }

    function createCheckbox(label, checked) {
        const wrapper = document.createElement('label');
        wrapper.className = 'oncb-checkbox';
        const input = document.createElement('input');
        input.type = 'checkbox';
        input.checked = checked;
        const text = document.createElement('span');
        text.textContent = label;
        wrapper.append(input, text);
        return { wrapper, input };
    }

    function updateDerivedSections(widget, data, nodes) {
        const result = buildSnippet(data);

        nodes.status.className = `oncb-status ${result.ok ? 'ok' : 'error'}`;
        nodes.status.innerHTML = '';

        const heading = document.createElement('strong');
        heading.textContent = result.ok ? 'Ready to copy.' : 'Needs attention.';
        nodes.status.appendChild(heading);

        if (result.ok) {
            const summary = document.createElement('div');
            const targetLabel = result.mode === 'environment' ? 'environment' : 'command';
            summary.textContent = ` ${result.totalArguments} field${result.totalArguments === 1 ? '' : 's'} mapped in ${result.signature || '(none)'} for this ${targetLabel}.`;
            nodes.status.appendChild(summary);
        } else {
            const list = document.createElement('ul');
            list.className = 'oncb-list';
            result.errors.forEach(error => {
                const item = document.createElement('li');
                item.textContent = error;
                list.appendChild(item);
            });
            nodes.status.appendChild(list);
        }

        nodes.signature.textContent = result.signature || '(empty)';
        nodes.preview.value = result.snippet || '';
        nodes.guide.innerHTML = '';

        if (result.definitions.length === 0) {
            const empty = document.createElement('p');
            empty.className = 'oncb-muted';
            empty.textContent = 'Add arguments above to assign #1, #2, and so on.';
            nodes.guide.appendChild(empty);
        } else {
            const list = document.createElement('ul');
            list.className = 'oncb-list';
            result.definitions.forEach(definition => {
                const item = document.createElement('li');
                item.textContent = `#${definition.index} — ${definition.label} (${definition.spec}) — ${definition.hint}`;
                list.appendChild(item);
            });
            nodes.guide.appendChild(list);
        }

        return result;
    }

    function renderBuilder(widget) {
